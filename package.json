{
  "name": "monte-castelo-vibed",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-simulations.mjs --prune && tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "playwright test",
    "simulate": "npm run build && node scripts/autoplay.mjs",
    "train": "npm run build && node scripts/train.mjs",
    "simulate:matrix": "npm run build && node scripts/round-robin.mjs 10 200001 && node scripts/report-round-robin.mjs",
    "simulations:check": "node scripts/check-simulations.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "version": "0.1.11"
}
